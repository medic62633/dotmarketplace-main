# Copy to .env and fill in real values. Never commit .env — it's gitignored
# on purpose. See README.md "Configuration" for the full description of
# each variable and what validateEnv() requires in production.

# --- Database ---
MONGODB_URI=
# ALLOW_MEMORY_STORE=true is dev-only — validateEnv() refuses it in production.
ALLOW_MEMORY_STORE=false

# --- Server ---
PORT=3000
NODE_ENV=development
PUBLIC_URL=http://localhost:3000
TRUST_PROXY=false

# --- Portal access (seller/admin) ---
# Required in production. An unguessable path prefix, no leading slash.
PORTAL_SECRET_PATH=
PORTAL_ALLOWED_IPS=
PORTAL_DISABLE=false

# --- Bootstrap admin ---
ADMIN_EMAIL=admin@dot.market
# Required in production — the default is the world-known "test12345".
ADMIN_PASSWORD=

# --- Auth / sessions ---
# DEMO_AUTH=true is dev-only — validateEnv() refuses it in production.
DEMO_AUTH=false
SESSION_TTL_DAYS=30

# --- Stock credential encryption ---
# Required in production. AES-256-GCM key (64-char hex, or any string —
# non-hex strings are scrypt-stretched). Losing this makes all stored
# credentials unrecoverable.
STOCK_SECRET=
# Only set after rotating STOCK_SECRET, to keep decrypting pre-rotation stock.
STOCK_SECRET_OLD=

# --- Payments ---
# Crypto payments go directly on-chain to your own wallets — there is no
# external payment processor. Leave PAYMENT_PROVIDER empty for wallet-only
# mode (Dot Wallet balance payments still work). To accept crypto directly,
# set PAYMENT_PROVIDER to one of: native_tron|native_eth|native_bsc|
# native_sol|native_sol_usdt|native_btc|native_ltc — see README "Native
# crypto payments". Untested against any real chain; testnet-verify before
# mainnet. Only the block below for whichever one PAYMENT_PROVIDER selects
# matters, and you must pool deposit addresses via the admin portal's
# Crypto tab before checkout will work.
PAYMENT_PROVIDER=
PLATFORM_FEE_PERCENT=2.5
PAYMENT_PENDING_TTL_MS=
TRONGRID_API_KEY=
NATIVE_TRON_API_BASE=
NATIVE_TRON_USDT_CONTRACT=
NATIVE_TRON_CONFIRM_SECONDS=60
NATIVE_ETH_RPC_URL=
NATIVE_ETH_USDT_CONTRACT=
NATIVE_ETH_USDT_DECIMALS=
NATIVE_ETH_CONFIRM_SECONDS=90
NATIVE_BSC_RPC_URL=
NATIVE_BSC_USDT_CONTRACT=
NATIVE_BSC_USDT_DECIMALS=
NATIVE_BSC_CONFIRM_SECONDS=90
NATIVE_SOL_RPC_URL=
NATIVE_SOL_USDT_MINT=
NATIVE_SOL_CONFIRM_SECONDS=30
NATIVE_BTC_API_BASE=
NATIVE_BTC_CONFIRM_SECONDS=0
NATIVE_LTC_API_BASE=
NATIVE_LTC_CONFIRM_SECONDS=0
# native_btc, native_ltc, and native_sol (plain SOL, not native_sol_usdt) are
# not USD-pegged, so lib/payments/fx.js converts the USDT listing price to a
# coin amount via a live CoinGecko lookup at invoice creation. Set one of
# these to pin a fixed USD rate instead of calling out at all — a manual
# override/fallback if you don't want to depend on CoinGecko being up.
# Required in any environment with no outbound internet access.
NATIVE_BTC_USD_RATE=
NATIVE_LTC_USD_RATE=
NATIVE_SOL_USD_RATE=

# --- Outbound email ---
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
