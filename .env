PUBLIC_URL=https://obalapi.com
TRUST_PROXY=true

# Local demo: allow passwordless seller-inbox login.
DEMO_AUTH=false
# Also set NODE_ENV=production in PM2/systemd (not only here).
NODE_ENV=production

# Production admin + hidden portal paths (save these somewhere secure).
