# Dot Marketplace — production configuration (keep this file private; 0600 perms)
# NOTE: running `npm start` with this file connects to the PRODUCTION Atlas
# database and real Resend/OxaPay accounts. Use ALLOW_MEMORY_STORE=true without
# this file for safe local dev.

# MongoDB Atlas — ROTATE the database user's password in Atlas, then paste the
# new URI here. (Atlas > Database Access > asuragod6482rj_db_user > Edit Password)
MONGODB_URI=mongodb+srv://asuragod6482rj_db_user:asT0yxk7t0O9caEw@dotmarket.0rxpr8m.mongodb.net/dotmarket?retryWrites=true&w=majority&appName=dotmarket

# Local MongoDB fallback (docker: npm run db:up)
# MONGODB_URI=mongodb://127.0.0.1:27017/dotmarket

PORT=3000
PAYMENT_PROVIDER=oxapay
# OxaPay merchant key — ROTATE in the OxaPay merchant dashboard, paste new key.
OXAPAY_MERCHANT_API_KEY=GYOORD-NZG65T-TG7LX4-JSSKWV
